# =====================================================================
# Git Ignore Configuration — GLS/WLS Econometrics Project
# =====================================================================

# Virtual Environments
.venv/
venv/
env/
ENV/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Jupyter & Streamlit Cache
.ipynb_checkpoints/
.streamlit/secrets.toml

# R Temporary & Workspace Artifacts
.Rhistory
.Rdata
.RData
.Ruserdata
*.Rproj.user/

# IDE & Text Editor Files
.idea/
.vscode/
*.swp
*.swo
*~
.directory

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------------
# Datasets: EXPLICITLY TRACKED & PUSHED TO GITHUB
# ---------------------------------------------------------------------
!data/
!data/raw/
!data/raw/*
!data/processed/
!data/processed/*

# ---------------------------------------------------------------------
# Outputs & Figures: Tracked so charts and tables display on GitHub
# ---------------------------------------------------------------------
!output/
!output/figures/
!output/figures/*
!output/tables/
!output/tables/*
